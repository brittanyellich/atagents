{
  "id": "chat.atagents.document.document",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "title",
          "body",
          "createdAt",
          "updatedAt",
          "path"
        ],
        "properties": {
          "body": {
            "type": "blob",
            "accept": [
              "text/markdown"
            ],
            "maxSize": 65536
          },
          "path": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "channel": {
            "ref": "chat.atagents.defs#strongRef",
            "type": "ref"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxLength": 50
          },
          "previous": {
            "ref": "chat.atagents.defs#strongRef",
            "type": "ref"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1,
  "description": "Experimental shared Markdown document revision. Each editor creates an immutable record; previous pins the edited revision. Path is relative to the optional channel or the whole Space."
}
